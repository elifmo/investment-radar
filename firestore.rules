rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /daily_candidates/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /scan_meta/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /macro_regime/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /quality_grades/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /sector_status/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /sector_status_history/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /sector_heatmap/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /etf_scans/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /radar_items/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
